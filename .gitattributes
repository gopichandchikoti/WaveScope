# Normalise text to LF in the repository so Windows and Linux (CI) agree.
* text=auto eol=lf

# Scripts that Windows tools expect to be CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.woff binary
*.woff2 binary
*.apk binary
*.keystore binary
*.jks binary
