{
  "version": "1.0.0",
  "name": "wavescope",
  "scripts": {
    "android:sync": "cap sync android",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "android:build": "node scripts/android.mjs",
    "start": "node server/index.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bootstrap": "npm ci",
    "dev": "node server/index.mjs",
    "test:api": "node scripts/check.mjs",
    "test:coverage:domain": "vitest run --coverage --coverage.include=src/domain.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:browser": "node scripts/browser-check.mjs",
    "test:speed": "node scripts/speed-check.mjs",
    "test:android": "node scripts/android-check.mjs",
    "verify:apk": "node scripts/verify-apk.mjs artifacts/wavescope-debug.apk"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "9.39.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.0",
    "fake-indexeddb": "6.0.0",
    "jsdom": "26.1.0",
    "playwright-core": "1.64.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "private": true
}
